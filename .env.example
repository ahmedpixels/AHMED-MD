# ║        AHMED-MD CONFIGURATION        ║
# ╚══════════════════════════════════════╝

# Session ID from ahmedxmd.com
SESSION_ID=AHMED-MD_63396528bf63e6b6537910400f1efb1c

# Bot prefix — change to anything you want (e.g: ! # / or leave empty for no prefix)
PREFIX=.

# Your WhatsApp number (with country code, no +)
OWNER_NUMBER=923216479192

# Bot name shown in menu and messages
BOT_NAME=AHMED-MD

# Mode: public (everyone can use) or private (only owner)
MODE=private

# Auto read messages: true or false
AUTO_READ=false

# Auto typing indicator: true or false
AUTO_TYPING=true

# MongoDB URI for data persistence (settings, warns, custom commands, etc.)
# Note: NOT used for session storage, making the bot super fast.
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/database

# Pairing website backend API URL
PAIR_URL=https://pair-j2ft.onrender.com

# Custom emojis for auto status reaction (comma separated)
STATUS_REACTION_EMOJIS=😁,😆,😅,😂,🥹,🤣,🥲,☺️,😇,🙂,🙃,😘,😉,😙,🥸,🤓,😜,🙁,😞,☹️,😣,🥳,⚖️
